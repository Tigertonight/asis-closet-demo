# selfit local runtime configuration.
# Copy this file to .env and fill the keys / endpoints you want to enable.

# ---------------------------------------------------------------------------
# Demo deployment guardrails
# ---------------------------------------------------------------------------
# Use SELFIT_ENV=demo or production when exposing the demo outside localhost.
SELFIT_ENV=local
SELFIT_PUBLIC_DEMO=0

# Required for public demos. Generate a long random value, for example:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
SELFIT_AUTH_SECRET=

# Local development may return the fixed code. Public demos must keep these 0.
SELFIT_AUTH_DEV_CODE=0000
SELFIT_AUTH_RETURN_DEV_CODE=1
SELFIT_AUTH_ALLOW_MOCK_CODES=1
SELFIT_AUTH_MOCK_CODES=0000,0001

# Basic abuse controls for a small invite-only demo.
SELFIT_MAX_REQUEST_BODY_MB=36
SELFIT_AUTH_RATE_LIMIT=20
SELFIT_AUTH_RATE_WINDOW_SECONDS=3600
SELFIT_UPLOAD_RATE_LIMIT=60
SELFIT_UPLOAD_RATE_WINDOW_SECONDS=3600
SELFIT_AI_RATE_LIMIT=30
SELFIT_AI_RATE_WINDOW_SECONDS=3600
SELFIT_API_RATE_LIMIT=240
SELFIT_API_RATE_WINDOW_SECONDS=3600
SELFIT_CLEANUP_DAYS=7
SELFIT_CLEANUP_INTERVAL_SECONDS=21600

# selfit onboarding session TTL in hours. Expired sessions return session.expired.
SELFIT_ONBOARDING_SESSION_TTL_HOURS=24
# 持链接可见的脱敏报告快照有效期（固定范围 1-30 天，当前产品默认 7 天）。
SELFIT_PUBLIC_REPORT_SHARE_TTL_DAYS=7

# Onboarding metadata store backend: json (default, sessions.json) or sqlite
# (sessions.sqlite3, transactional writes). Original photo/share assets are
# long-term data assets and stay on disk/object storage regardless of backend.
SELFIT_ONBOARDING_STORE_BACKEND=json

# Mirror -> phone one-time handoff. Public deployments must set the canonical
# HTTPS origin so the QR opens the phone experience instead of an internal host.
SELFIT_PUBLIC_BASE_URL=
# Defaults to SELFIT_AUTH_SECRET when empty. Use a separate random secret in production.
SELFIT_MIRROR_HANDOFF_SECRET=
# One-time QR validity in seconds (minimum 60, default 10 minutes).
SELFIT_MIRROR_HANDOFF_TTL_SECONDS=600

# selfit onboarding photo inspector: attribute (真实算法检测) | accept_all (联调占位全放行).
SELFIT_PHOTO_INSPECTOR=attribute

# /selfit 页面服务端注入的 API 模式：mock（本地演示）| live（联调/正式）。
SELFIT_ONBOARDING_API_MODE=live
# 登录默认沿用 SELFIT_ONBOARDING_API_MODE；需要单独切换时可覆盖为 mock 或 live。
SELFIT_AUTH_FRONTEND_MODE=

# 数据资产（用户原图/分享图）存储：local（默认，本地目录）| oss（阿里云 OSS）| s3（S3 兼容：
# 七牛 Kodo / Cloudflare R2 / Backblaze B2 / 腾讯 COS）。资产只增不删；
# oss 需 pip install oss2，s3 需 pip install boto3（均见 requirements-ai.txt）。
SELFIT_ASSET_STORE=local
SELFIT_OSS_ENDPOINT=
SELFIT_OSS_BUCKET=
SELFIT_OSS_ACCESS_KEY_ID=
SELFIT_OSS_ACCESS_KEY_SECRET=
SELFIT_OSS_PREFIX=selfit/onboarding
SELFIT_OSS_PUBLIC_BASE_URL=
# S3 兼容平台示例（七牛华东）：SELFIT_S3_ENDPOINT=https://s3.cn-east-1.qiniucs.com
SELFIT_S3_ENDPOINT=
SELFIT_S3_BUCKET=
SELFIT_S3_ACCESS_KEY_ID=
SELFIT_S3_SECRET_ACCESS_KEY=
SELFIT_S3_REGION=
SELFIT_S3_PREFIX=selfit/onboarding
SELFIT_S3_PUBLIC_BASE_URL=
# 报告内容池（公开静态图片）的 CDN 域名；配置后 builder 返回的相对路径
# 会经 content_url() 解析为 CDN 完整地址，前端直连 CDN 加载。
SELFIT_CONTENT_CDN_BASE_URL=
# 内容池清单路径（穿搭笔记 + 妆容/发型静态映射条目）。
# mock 数据由 scripts/seed_selfit_content_pool.py 生成；真实数据资产到位后
# 直接替换该 JSON（图片走公开桶 + 上面的 CDN 域名）。
SELFIT_CONTENT_POOL_PATH=
# auto: valid published V2 first, then V1; v1: force stable pool; v2: request
# V2 but safely fall back to V1 until all publish gates pass.
SELFIT_CONTENT_POOL_VERSION=auto

# ---------------------------------------------------------------------------
# Try-on image generation
# ---------------------------------------------------------------------------
# OpenAI-compatible images.edit provider. Use either a local proxy or a hosted
# provider that supports image edit output.
TRYON_OPENAI_BASE_URL=http://127.0.0.1:8787/v1
TRYON_OPENAI_API_KEY=
TRYON_VISION_MODEL=gpt-5.5

# Runway Google generateContent-compatible proxy. If both providers are present,
# the app capability endpoint will report which one is usable.
TRYON_RUNWAY_GOOGLE_URL=https://runway.devops.rednote.life/openai/google/v1:generateContent
TRYON_RUNWAY_GOOGLE_API_KEY=
TRYON_RUNWAY_TEMPERATURE=1
TRYON_RUNWAY_MAX_OUTPUT_TOKENS=32768
TRYON_RUNWAY_TOP_P=0.95

# ---------------------------------------------------------------------------
# Closet segmentation / matting
# ---------------------------------------------------------------------------
# The default model is downloaded by transformers when torch + transformers are
# installed and the model cache/network is available.
SELFIT_SEGFORMER_MODEL=mattmdjaga/segformer_b2_clothes
SELFIT_SEGFORMER_DEVICE=auto

# rembg is used automatically when installed. Set to 0 to keep semantic mask
# alpha only.
SELFIT_REMBG_ENABLED=1

# Optional high-quality matting sidecar / model. Reserved for BiRefNet.
SELFIT_BIREFNET_ENDPOINT=
SELFIT_BIREFNET_MODEL=

# ---------------------------------------------------------------------------
# AI stylist runtime
# ---------------------------------------------------------------------------
# FastAPI calls the independent OpenClaw fork/sidecar through these endpoints.
STYLIST_OPENCLAW_CHAT_URL=http://127.0.0.1:18789/api/selfit/chat
STYLIST_OPENCLAW_MEMORY_URL=http://127.0.0.1:18789/api/selfit/memory
STYLIST_OPENCLAW_AGENT_ID=selfit-stylist
STYLIST_SELFIT_TOOL_BASE_URL=http://127.0.0.1:8002
STYLIST_OPENCLAW_TIMEOUT=180

# Optional model route override. If empty, OpenClaw defaults to openai/gpt-5.5.
# The provider prefix must match the key you configure below.
# Examples:
#   STYLIST_OPENCLAW_MODEL=openai/gpt-5.5
#   STYLIST_OPENCLAW_MODEL=anthropic/claude-sonnet-4-6
#   STYLIST_OPENCLAW_MODEL=google/gemini-2.5-flash
#   STYLIST_OPENCLAW_MODEL=openrouter/auto
#   STYLIST_OPENCLAW_MODEL=minimax/MiniMax-M3           # MiniMax API key
#   STYLIST_OPENCLAW_MODEL=minimax-portal/MiniMax-M3    # MiniMax token plan
STYLIST_OPENCLAW_MODEL=minimax-portal/MiniMax-M3

# Configure exactly the provider key that matches STYLIST_OPENCLAW_MODEL.
# Leave unused providers empty. Key failures are surfaced as ai_unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
# MiniMax ordinary API key. Leave empty when using token plan.
MINIMAX_API_KEY=
# MiniMax token plan / OAuth token. Use this with minimax-portal/MiniMax-M3.
MINIMAX_OAUTH_TOKEN=

SELFIT_OPENCLAW_BRIDGE_HOST=127.0.0.1
SELFIT_OPENCLAW_BRIDGE_PORT=18789

# Only enable this for UI demos. Formal mode should leave it empty/0 so model
# key failures surface as ai_unavailable.
STYLIST_DEMO_MODE=0

# ---------------------------------------------------------------------------
# Xiaohongshu / RedNote MCP sidecar
# ---------------------------------------------------------------------------
SELFIT_XHS_MCP_URL=http://127.0.0.1:18060/mcp
SELFIT_XHS_MCP_MODE=streamable-http
SELFIT_XHS_ALLOWED_TOOLS=check_login_status,search_feeds,get_feed_detail,list_feeds
# Internal recommendation validation: default off; exact account IDs only.
SELFIT_RECOMMENDATION_V3_ENABLED=0
SELFIT_RECOMMENDATION_V3_USERS=
# Optional paths / weights; never store credentials in review artifacts.
# SELFIT_RECOMMENDATION_VISUAL_PATH=app/data/recommendation-visual.v1.json
# SELFIT_RECOMMENDATION_V3_WEIGHTS={"color":0.4,"persona":0.3,"axes":0.15,"scene":0.1,"behavior":0.05}
# Autumn/winter validation additionally requires the existing V3 account allowlist.
# Never enabled by query-string or a test-persona switch.
SELFIT_RECOMMENDATION_AW_ENABLED=0
# Optional internal test condition only; empty keeps requests without a season on the existing strategy.
# Allowed values: autumn, winter. This is not the user's weather or location.
SELFIT_RECOMMENDATION_AW_SEASON=
