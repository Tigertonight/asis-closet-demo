{
  "agents": {
    "registered": {
      "asis-stylist": {
        "identity": "agents/asis-stylist/agent.md",
        "workspace": ".",
        "skills": {
          "roots": ["skills"]
        },
        "tools": {
          "allow": [
            "asis_closet_search",
            "asis_get_item",
            "asis_compose_outfit",
            "asis_save_outfit",
            "asis_tryon_from_outfit",
            "asis_xhs_search",
            "asis_xhs_fetch_note",
            "asis_style_kb_search"
          ]
        },
        "memory": {
          "namespace": "asis-stylist"
        }
      }
    }
  },
  "asis": {
    "toolBaseUrl": "${ASIS_TOOL_BASE_URL:-http://127.0.0.1:8002}",
    "errorPolicy": {
      "modelUnavailable": "fail_closed"
    }
  }
}
