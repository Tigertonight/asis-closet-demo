.DS_Store

# Local environment and secrets
.env
.env.*
!.env.example
!.env.demo.example
.venv/
venv/
env/

# Python caches and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/results/
tests/fixtures/tryon_models/_backup_*/
tests/fixtures/tryon_models/female_models_triptych_*.png

# Runtime uploads and generated artifacts
uploads/
outputs/
red_square_test.png
openclaw-workspace-state.json
.cowork-deploy/
.evidence-reconstruction/
cowork-login.command
tmp/
cowork/*.zip
mirro-photo-template-studio/reference/**/__MACOSX/
mirro-photo-template-studio/reference/**/._*

# Keep lossless Content V2 PNG masters locally; publish the optimized WebP files.
app/static/selfit/assets/content_v2/**/*.png

# Audit contact sheets and raw generations are reproducible local evidence;
# commit their structured JSON/TSV decisions, not the bulky review media.
docs/audits/**/*.png
docs/audits/**/*.jpg
docs/audits/**/*.jpeg
docs/audits/**/*.webp
docs/audits/**/*.zip

# Agent/runtime generated dependencies and local state
selfit-agent-runtime/vendor/
selfit-agent-runtime/.openclaw/
selfit-agent-runtime/config/*.local.json
selfit-agent-runtime/*workspace-state*.json

# Logs and process files
*.log
*.pid

# OS/editor noise
.idea/
.vscode/
*.swp

# QA 目检素材的分析缓存（可由页面重新生成）；照片与 manifest 进 git，
# 管理员上传/用户归档的照片随代码一起发布，避免服务器文件与 git 漂移。
# app/models（MediaPipe 模型，<10MB）同样进 git：部署只依赖 git 一个来源。
qa_photos/_results.json
qa_photos/_overlays/
qa_photos/_annotations.json
