{
  "openapi": "3.1.0",
  "info": {
    "title": "selfit Stylist Tools",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8002"
    }
  ],
  "paths": {
    "/stylist/tools/{tool_name}": {
      "post": {
        "operationId": "selfit_tool",
        "parameters": [
          {
            "name": "tool_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "selfit_closet_search",
                "selfit_get_item",
                "selfit_compose_outfit",
                "selfit_save_outfit",
                "selfit_tryon_from_outfit",
                "selfit_xhs_search",
                "selfit_xhs_fetch_note",
                "selfit_style_kb_search"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool result"
          }
        }
      }
    }
  }
}
