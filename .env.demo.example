# Copy to .env.demo on the server. Do not commit the filled file.

SELFIT_ENV=demo
SELFIT_PUBLIC_DEMO=1
SELFIT_AUTH_SECRET=
SELFIT_AUTH_DEV_CODE=
SELFIT_AUTH_RETURN_DEV_CODE=0
SELFIT_AUTH_ALLOW_MOCK_CODES=0
# 手机号免短信直接登录（路演默认开；正式版接短信/微信后设 0 关闭）
SELFIT_AUTH_ALLOW_PHONE_DIRECT=1
# 邀请码登录按钮默认隐藏，内部测试时设 1
SELFIT_SHOW_INVITE_LOGIN=0

SELFIT_MAX_REQUEST_BODY_MB=36
SELFIT_AUTH_RATE_LIMIT=20
SELFIT_AUTH_RATE_WINDOW_SECONDS=3600
SELFIT_UPLOAD_RATE_LIMIT=60
SELFIT_UPLOAD_RATE_WINDOW_SECONDS=3600
SELFIT_AI_RATE_LIMIT=30
SELFIT_AI_RATE_WINDOW_SECONDS=3600
# 用户数据是训练/分析资产，默认永久保留（36500 天 ≈ 100 年）
SELFIT_CLEANUP_DAYS=36500
# onboarding 会话记录（问卷答案/照片属性）保留 10 年
SELFIT_ONBOARDING_SESSION_TTL_HOURS=87600
SELFIT_CLEANUP_INTERVAL_SECONDS=21600
REQUIRE_SIDECARS=1
# 试穿图片生成 provider key 未配置时是否仍允许服务就绪（0=允许，用于先跑 onboarding/报告流程）
REQUIRE_TRYON=1

TRYON_RUNWAY_GOOGLE_URL=https://runway.devops.rednote.life/openai/google/v1:generateContent
TRYON_RUNWAY_GOOGLE_API_KEY=

STYLIST_OPENCLAW_CHAT_URL=http://127.0.0.1:18789/api/selfit/chat
STYLIST_OPENCLAW_MEMORY_URL=http://127.0.0.1:18789/api/selfit/memory
STYLIST_OPENCLAW_AGENT_ID=selfit-stylist
STYLIST_SELFIT_TOOL_BASE_URL=http://127.0.0.1:8002
STYLIST_OPENCLAW_TIMEOUT=180
STYLIST_OPENCLAW_MODEL=minimax-portal/MiniMax-M3
MINIMAX_OAUTH_TOKEN=
MINIMAX_API_KEY=

SELFIT_OPENCLAW_BRIDGE_HOST=127.0.0.1
SELFIT_OPENCLAW_BRIDGE_PORT=18789

SELFIT_XHS_MCP_URL=http://127.0.0.1:18060/mcp
SELFIT_XHS_MCP_MODE=streamable-http
SELFIT_XHS_ALLOWED_TOOLS=check_login_status,search_feeds,get_feed_detail,list_feeds

