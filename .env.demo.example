# Copy to .env.demo on the server. Do not commit the filled file.

ASIS_ENV=demo
ASIS_PUBLIC_DEMO=1
ASIS_AUTH_SECRET=
ASIS_AUTH_DEV_CODE=
ASIS_AUTH_RETURN_DEV_CODE=0
ASIS_AUTH_ALLOW_MOCK_CODES=0

ASIS_MAX_REQUEST_BODY_MB=36
ASIS_AUTH_RATE_LIMIT=20
ASIS_AUTH_RATE_WINDOW_SECONDS=3600
ASIS_UPLOAD_RATE_LIMIT=60
ASIS_UPLOAD_RATE_WINDOW_SECONDS=3600
ASIS_AI_RATE_LIMIT=30
ASIS_AI_RATE_WINDOW_SECONDS=3600
ASIS_CLEANUP_DAYS=7
ASIS_CLEANUP_INTERVAL_SECONDS=21600
REQUIRE_SIDECARS=1

TRYON_RUNWAY_GOOGLE_URL=https://runway.devops.rednote.life/openai/google/v1:generateContent
TRYON_RUNWAY_GOOGLE_API_KEY=

STYLIST_OPENCLAW_CHAT_URL=http://127.0.0.1:18789/api/asis/chat
STYLIST_OPENCLAW_MEMORY_URL=http://127.0.0.1:18789/api/asis/memory
STYLIST_OPENCLAW_AGENT_ID=asis-stylist
STYLIST_ASIS_TOOL_BASE_URL=http://127.0.0.1:8002
STYLIST_OPENCLAW_TIMEOUT=180
STYLIST_OPENCLAW_MODEL=minimax-portal/MiniMax-M3
MINIMAX_OAUTH_TOKEN=
MINIMAX_API_KEY=

ASIS_OPENCLAW_BRIDGE_HOST=127.0.0.1
ASIS_OPENCLAW_BRIDGE_PORT=18789

ASIS_XHS_MCP_URL=http://127.0.0.1:18060/mcp
ASIS_XHS_MCP_MODE=streamable-http
ASIS_XHS_ALLOWED_TOOLS=check_login_status,search_feeds,get_feed_detail,list_feeds

