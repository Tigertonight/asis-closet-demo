    "components": {
      "button_style": "pill-shaped, direct labels, rose only for primary actions",
      "input_style": "warm white surface with restrained outline",
      "card_style": "warm white or wine textile editorial surface with 16-24px corners",
      "navigation_pattern": "light translucent bottom navigation",
      "modal_style": "mobile sheet with image-first hierarchy",
      "list_style": "two-column image-led recommendation grid",
      "component_notes": "The flatlay composition remains identical between recommendation card, detail preview, and try-on handoff."
