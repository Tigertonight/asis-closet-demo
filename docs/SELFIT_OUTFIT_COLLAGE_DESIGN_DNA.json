      "genre": "consumer fashion editorial utility",
      "personality_traits": ["meticulous", "warm", "tasteful", "quietly confident"],
      "adjectives": ["balanced", "image-first", "crafted", "stable"]
    },
    "visual_language": {
      "complexity": "moderate",
      "ornamentation": "subtle accents",
      "whitespace_usage": "functional breathing room measured around visible silhouettes",
      "visual_weight_distribution": "one normalized main outfit group balanced by a lighter accessory rail",
      "focal_strategy": "single main outfit silhouette",
      "contrast_level": "medium",
      "texture_usage": "wine textile for brand surfaces and warm paper for product canvases"
    },
    "composition": {
      "hierarchy_method": "visible silhouette area and vertical span",
      "balance_type": "asymmetric",
      "flow_direction": "top-to-bottom main dressing order, then right-side accessories",
      "grouping_strategy": "top and lower garment form one optical group; dress is an equivalent single group",
      "negative_space_role": "separates semantic groups without weakening outfit cohesion"
    },
    "imagery": {
      "photo_treatment": "transparent cutouts on warm paper with restrained soft shadows",
      "illustration_style": "none",
      "graphic_elements": "white lace and wine textile reserved for branded framing",
      "pattern_usage": "subtle textile and lace, never behind garment edge evaluation",
      "image_shape": "stable 928:1232 portrait canvas"
    },
    "interaction_feel": {
      "feedback_style": "immediate and quiet",
      "hover_behavior": "subtle lift on desktop",
      "transition_personality": "smooth glide",
      "loading_style": "branded textile progress state",
      "microinteraction_density": "low"
    },
    "brand_voice_in_ui": {
      "tone": "warm stylist guidance",
      "formality": "conversational professional",
      "cta_style": "friendly invitation",
      "empty_state_approach": "show the next useful action",
      "error_tone": "specific, reassuring, and recoverable"
    }
  },
  "visual_effects": {
    "overview": {"effect_intensity": "subtle-accent", "performance_tier": "lightweight", "fallback_strategy": "static snapshot", "primary_technology": "CSS and deterministic Pillow rendering"},
    "background_effects": {"type": "texture-image", "description": "Static wine textile on branded card surfaces", "technology": "CSS", "params": {"color_palette": ["#8A011B", "#FFFAF8"], "speed": "0", "density": "low", "opacity": 1, "blend_mode": "normal"}},
    "particle_systems": {"enabled": false, "type": "none", "description": "No particles", "technology": "none", "params": {"count": 0, "shape": "none", "size_range": "none", "movement_pattern": "none", "color_behavior": "none", "interaction": "none", "spawn_area": "none"}},
    "3d_elements": {"enabled": false, "type": "none", "description": "No 3D elements", "technology": "none", "params": {"renderer": "none", "lighting": "none", "camera": "none", "materials": [], "geometry": [], "post_processing": [], "interaction_model": "none"}},
    "shader_effects": {"enabled": false, "type": "none", "description": "No shaders", "technology": "none", "params": {"uniforms": {}, "vertex_manipulation": "none", "fragment_output": "none", "noise_type": "none", "distortion": "none"}},
    "scroll_effects": {"parallax": {"enabled": false, "layers": 0, "depth_range": "none", "speed_curve": "none"}, "scroll_triggered_animations": {"enabled": false, "trigger_points": [], "animation_type": "none", "scrub_behavior": "none"}, "scroll_morphing": {"enabled": false, "description": "none"}},
    "text_effects": {"type": "none", "description": "Static editorial typography", "technology": "CSS", "params": {"split_strategy": "none", "animation_per_unit": "none", "stagger": "0", "effect_style": "none"}},
    "cursor_effects": {"enabled": false, "type": "none", "description": "Native cursor", "params": {"shape": "native", "size": "native", "blend_mode": "normal", "trail": false, "interaction_zone": "none"}},
    "image_effects": {"type": "soft-shadow", "description": "Subtle silhouette-preserving shadow", "technology": "Pillow and CSS", "params": {"filter_pipeline": ["alpha trim", "contain", "soft shadow"], "hover_transform": "translateY(-1px)", "reveal_animation": "fade", "distortion_type": "none"}},
    "glassmorphism_neumorphism": {"enabled": false, "style": "none", "params": {"blur_radius": "0", "transparency": 1, "border_treatment": "none", "shadow_type": "soft diffused", "light_source_angle": "top"}},
    "canvas_drawings": {"enabled": true, "type": "deterministic-flatlay", "description": "Server-rendered placement of transparent fashion cutouts", "technology": "Pillow", "params": {"draw_method": "alpha compositing into fixed semantic zones", "animation_loop": false, "color_scheme": "warm white", "responsiveness": "single canonical asset reused at all sizes", "interaction": "none"}},
    "svg_animations": {"enabled": false, "type": "none", "description": "Static SVG icons only", "params": {"animation_method": "none", "path_morphing": false, "stroke_animation": false, "filter_effects": []}},
    "composite_notes": "Visual area must be calculated from the trimmed visible alpha bounds. A top plus lower garment is one optical main group and should be perceptually compensated to 82-90% of a dress group's visible area while matching its 74-78% vertical span."
  }
